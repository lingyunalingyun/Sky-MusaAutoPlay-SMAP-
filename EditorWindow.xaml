<Window x:Class="SMAP_WPF.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SMAP_WPF"
        Width="1232" Height="740" MinWidth="900" MinHeight="520"
        Icon="/SMAP;component/Assets/logo.png" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <DataTemplate x:Key="EditorChoiceLabel"><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/></DataTemplate>
        <Style x:Key="TrackStateToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="28"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFg}"/><Setter Property="Background" Value="{DynamicResource ComboBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Grid>
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="FocusRing" Margin="-3" CornerRadius="7" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextFg}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TrackMuteToggle" TargetType="ToggleButton" BasedOn="{StaticResource TrackStateToggle}">
            <Style.Triggers><Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="#efb24f"/><Setter Property="Foreground" Value="#292016"/><Setter Property="BorderBrush" Value="#ffd28c"/>
            </Trigger></Style.Triggers>
        </Style>
        <Style x:Key="TrackSoloToggle" TargetType="ToggleButton" BasedOn="{StaticResource TrackStateToggle}">
            <Style.Triggers><Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="#72b1ff"/><Setter Property="Foreground" Value="#152d48"/><Setter Property="BorderBrush" Value="#b7d8ff"/>
            </Trigger></Style.Triggers>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton x:Name="decrease" Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton x:Name="increase" Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                                <Track.Thumb><Thumb MinWidth="12" MinHeight="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="2" CornerRadius="4" Background="{DynamicResource ScrollThumbBrush}"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                                <Setter TargetName="increase" Property="Command" Value="ScrollBar.PageRightCommand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/><Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BoxBorder}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="6"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFg}"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="31"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Grid>
                    <Border x:Name="row" Background="{TemplateBinding Background}" CornerRadius="4" Padding="7,5">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Icon" Width="15" Height="15" VerticalAlignment="Center"/>
                            <TextBlock x:Name="check" Text="✓" Visibility="Collapsed" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Header}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock x:Name="arrow" Grid.Column="2" Text="›" Visibility="Collapsed" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                        <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BoxBorder}" BorderThickness="1" CornerRadius="6" Padding="6" MinWidth="150" MaxWidth="300">
                            <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource MenuHi}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="check" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="HasItems" Value="True"><Setter TargetName="arrow" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="6,5" Background="{DynamicResource BoxBorder}"/></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="{DynamicResource NeutralBtnFg}"/>
            <Setter Property="Background" Value="{DynamicResource NeutralBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
            <Setter Property="Background" Value="{DynamicResource BoxBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BoxBorder}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
    <Border x:Name="WindowSurface" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1" CornerRadius="21" Margin="6" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Border x:Name="TitleSurface" Background="{DynamicResource TitleGrad}" CornerRadius="10" MouseLeftButtonDown="Title_MouseDown">
                <DockPanel Margin="12,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="14" Height="14" Fill="#c9c9c9" Margin="5,0" MouseLeftButtonDown="Min_Click"/>
                        <Ellipse Width="14" Height="14" Fill="#e6b52a" Margin="5,0" MouseLeftButtonDown="Max_Click"/>
                        <Ellipse Width="14" Height="14" Fill="#e0483b" Margin="5,0" MouseLeftButtonDown="Close_Click"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource CaptionFg}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
            <Border x:Name="ToolbarSurface" Grid.Row="1" Panel.ZIndex="20" Background="{DynamicResource PanelBg}" CornerRadius="10" Margin="0,12,0,0" Padding="5">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <local:CommandMenuButton x:Name="MoreButton" Height="32"/><Button x:Name="ModeButton" Height="32"/><Button x:Name="SaveButton" Height="32"/>
                    </StackPanel>
                    <WrapPanel x:Name="ToolBar"/>
                </DockPanel>
            </Border>
            <DockPanel x:Name="TrackContext" Grid.Row="2" Panel.ZIndex="10" Margin="0,12,0,0">
                <Button x:Name="PropertiesButton" DockPanel.Dock="Right" Margin="0" Height="32"/>
                <Button x:Name="FollowButton" DockPanel.Dock="Right" Margin="0,0,6,0" Height="32"/>
                <ComboBox x:Name="TrackSelect" Visibility="Collapsed" DockPanel.Dock="Left"/>
                <local:JoinedChoiceButton x:Name="TrackChoiceButton" DockPanel.Dock="Left"/>
                <TextBlock x:Name="TrackCaption" Foreground="{DynamicResource SubTextFg}" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <Grid Grid.Row="3" x:Name="WorkArea" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TrackColumn" Width="0"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="InspectorColumn" Width="0"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="TrackSurface" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BoxBorder}" BorderThickness="1" CornerRadius="10" Margin="0,0,12,0" Visibility="Collapsed" SizeChanged="Surface_SizeChanged">
                    <ContentControl x:Name="TrackHost"/>
                </Border>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <local:PianoRollOverview x:Name="Overview"/>
                    <Border x:Name="ViewportSurface" Grid.Row="1" Margin="0,12,0,0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BoxBorder}" BorderThickness="1" CornerRadius="10" SizeChanged="Surface_SizeChanged">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="14"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
                            <local:PianoRoll x:Name="Roll"/>
                            <ScrollBar x:Name="VerticalScroll" Grid.Column="1" Orientation="Vertical" SmallChange="22"/>
                            <ScrollBar x:Name="HorizontalScroll" Grid.Row="1" Orientation="Horizontal"/>
                        </Grid>
                    </Border>
                </Grid>
                <Border x:Name="InspectorSurface" Grid.Column="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BoxBorder}" BorderThickness="1" CornerRadius="10" Margin="12,0,0,0" Visibility="Collapsed" SizeChanged="Surface_SizeChanged">
                    <ContentControl x:Name="InspectorHost"/>
                </Border>
                <Grid x:Name="Drawer" Grid.ColumnSpan="3" Visibility="Collapsed">
                    <Button Background="#66000000" BorderThickness="0" Margin="0" Click="DismissDrawer_Click"/>
                    <Border Width="256" HorizontalAlignment="Left" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BoxBorder}" BorderThickness="1" CornerRadius="10" Padding="6" SizeChanged="Surface_SizeChanged">
                        <ContentControl x:Name="DrawerHost"/>
                    </Border>
                </Grid>
            </Grid>
            <Border Grid.Row="4" x:Name="KeyboardHost" Background="{DynamicResource PanelBg}" CornerRadius="10" Padding="8" Margin="0,12,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <Button x:Name="KeyboardButton" HorizontalAlignment="Left"/>
                        <UniformGrid x:Name="MapGrid" Rows="3" Columns="5" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <TextBlock x:Name="HintText" Foreground="{DynamicResource SubTextFg}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="22,4" FontSize="11"/>
                </DockPanel>
            </Border>
            <Border x:Name="StatusSurface" Grid.Row="5" Background="{DynamicResource PanelBg}" CornerRadius="10" Margin="0,12,0,0" Padding="8,0">
                <DockPanel>
                    <TextBlock x:Name="ZoomText" DockPanel.Dock="Right" Foreground="{DynamicResource SubTextFg}" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource SubTextFg}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
    <Canvas x:Name="EditorMenuLayer" Panel.ZIndex="100"/>
    </Grid>
</Window>
