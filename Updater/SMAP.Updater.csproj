<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SMAP.Updater</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Updates/UpdateManifest.cs" Link="UpdateManifest.cs" />
    <Compile Include="../Updates/ContentChunks.cs" Link="ContentChunks.cs" />
    <Compile Include="../Updates/UpdatePlan.cs" Link="UpdatePlan.cs" />
    <Compile Include="../Updates/UpdateTransaction.cs" Link="UpdateTransaction.cs" />
    <Compile Include="../Updates/UpdateTrust.cs" Link="UpdateTrust.cs" />
    <Compile Include="../Updates/UpdateHealth.cs" Link="UpdateHealth.cs" />
  </ItemGroup>
</Project>
