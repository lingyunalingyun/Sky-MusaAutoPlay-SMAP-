<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:g2="clr-namespace:SMAP_WPF" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SMAP_WPF">
        <Style x:Key="PopupOptionItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <g2:G2Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </g2:G2Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource MenuHi}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource RowSel}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LibraryChoiceButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
            <Setter Property="Background" Value="{DynamicResource ComboBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BoxBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <g2:G2Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <Grid>
                                <ContentPresenter Margin="14,0,34,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <Path Data="M0,0 L5,5 L10,0 Z" Fill="#999" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            </Grid>
                        </g2:G2Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="JoinedChoiceButtonStyle" TargetType="local:JoinedChoiceButton" BasedOn="{StaticResource LibraryChoiceButton}">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:JoinedChoiceButton">
                <Grid Background="Transparent" ClipToBounds="False">
                    <Canvas ClipToBounds="False">
                        <g2:G2Border x:Name="PART_Chrome" Width="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" Height="36"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                            <StackPanel x:Name="PART_Content" VerticalAlignment="Top">
                                <g2:G2Border x:Name="PART_Header" Height="34" Background="Transparent">
                                    <Grid><ContentPresenter Margin="14,0,34,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Path Data="M0,0 L5,5 L10,0 Z" Fill="#999" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    </Grid>
                                </g2:G2Border>
                                <g2:G2Border x:Name="PART_Separator" Height="1" Margin="9,0" Background="{DynamicResource BoxBorder}" Visibility="Collapsed"/>
                                <ListBox x:Name="PART_Options" Margin="4,4,4,5" MaxHeight="300" Background="Transparent" BorderThickness="0" Visibility="Collapsed"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemContainerStyle="{StaticResource PopupOptionItem}"/>
                                <ContentPresenter x:Name="PART_CustomContent" Visibility="Collapsed"/>
                            </StackPanel>
                        </g2:G2Border>
                    </Canvas>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PillChoiceButtonStyle" TargetType="local:PillChoiceButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:PillChoiceButton">
                <Grid ClipToBounds="False">
                    <g2:G2Border Padding="10,3" BorderThickness="1">
                        <TextBlock Text="{TemplateBinding Content}" Visibility="Hidden" TextTrimming="CharacterEllipsis"/>
                    </g2:G2Border>
                    <Canvas ClipToBounds="False">
                        <g2:G2Border x:Name="PART_Chrome" Canvas.Right="0" Canvas.Bottom="0" Background="{DynamicResource BoxBg}"
                                BorderBrush="{DynamicResource BtnBorder}" BorderThickness="1" CornerRadius="13">
                            <StackPanel x:Name="PART_Content" Width="198" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                <ListBox x:Name="PART_Options" Margin="4,5,4,4" MaxHeight="250" Background="Transparent" BorderThickness="0" Visibility="Collapsed"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel" local:SmoothScroll.Enabled="True">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource PopupOptionItem}">
                                        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
                                        </DataTemplate></Setter.Value></Setter>
                                    </Style></ListBox.ItemContainerStyle>
                                </ListBox>
                                <g2:G2Border x:Name="PART_Separator" Height="1" Margin="9,0" Background="{DynamicResource BoxBorder}" Visibility="Collapsed"/>
                                <g2:G2Border x:Name="PART_Header" Background="Transparent">
                                    <TextBlock Text="{TemplateBinding Content}" Margin="10,0" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </g2:G2Border>
                            </StackPanel>
                        </g2:G2Border>
                    </Canvas>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CommandMenuRow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <g2:G2Border x:Name="row" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                </g2:G2Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource MenuHi}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource RowSel}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CommandMenuButtonStyle" TargetType="local:CommandMenuButton">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFg}"/>
            <Setter Property="Background" Value="{DynamicResource NeutralBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorder}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:CommandMenuButton">
                <Grid ClipToBounds="False">
                    <g2:G2Border Padding="{TemplateBinding Padding}" BorderThickness="1"><ContentPresenter Visibility="Hidden"/></g2:G2Border>
                    <Canvas ClipToBounds="False">
                        <g2:G2Border x:Name="PART_Chrome" Background="{DynamicResource PanelBg}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <DockPanel x:Name="PART_Body" LastChildFill="True">
                                <g2:G2Border x:Name="PART_Header" Background="{TemplateBinding Background}" DockPanel.Dock="Top">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </g2:G2Border>
                                <ScrollViewer x:Name="PART_Scroll" Visibility="Collapsed" Margin="5,4,5,5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False" local:SmoothScroll.Enabled="True">
                                    <StackPanel x:Name="PART_Items"/>
                                </ScrollViewer>
                            </DockPanel>
                        </g2:G2Border>
                    </Canvas>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
</ResourceDictionary>
